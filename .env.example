# Discord application credentials — https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_dev_guild_id_for_local_command_registration

# PostgreSQL credentials (used by both the bot and the postgres service)
POSTGRES_USER=skywizz
POSTGRES_PASSWORD=change_me
POSTGRES_DB=skywizz

# Connection string — constructed from the vars above
# When running via docker compose the host is the service name 'postgres'
# When running locally (pnpm dev) replace 'postgres' with 'localhost'
DATABASE_URL=postgresql://skywizz:change_me@postgres:5432/skywizz

# Bot HTTP API — called by the web dashboard
BOT_API_SECRET=change_me_to_a_long_random_secret
BOT_API_PORT=3002

# Runtime
NODE_ENV=development
TIMEZONE=UTC
