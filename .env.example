# Discord application credentials — https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_dev_guild_id_for_local_command_registration

# PostgreSQL
# When running via docker compose, the host is the service name 'postgres'
# When running locally (pnpm dev), use 'localhost' instead
DATABASE_URL=postgresql://skywizz:password@postgres:5432/skywizz

# Runtime
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=UTC
